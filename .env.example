# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD OAUTH2 CREDENTIALS
# Create your application at https://discord.com/developers/applications
DISCORD_CLIENT_ID="123456789012345678"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# DISCORD NOTIFICATIONS
# Create a Webhook inside your Discord channel (e.g. #studio-orders or #deliveries)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"

# SESSION & SECURITY
# 32+ character random secret for JWT signing
JWT_SECRET="synthetix_super_secret_jwt_key_cyber_lilac_2026_change_in_prod"

# ACCESS CONTROL (RBAC)
# Comma-separated Discord Snowflake IDs with Administrator privileges
ADMIN_DISCORD_IDS="903391086054,123456789012345678"

# PAYMENT GATEWAYS & URLS (CONFIGURABLE ALSO VIA ADMIN PANEL)
PAYPAL_PAYMENT_URL="https://paypal.me/SynthetixStudio"
STRIPE_PAYMENT_LINK="https://buy.stripe.com/test_synthetix_checkout"
TEBEX_STORE_URL="https://synthetixstudio.tebex.io"
CRYPTO_WALLET_USDT="TFk8eN2Kq7Vw9k8Lm3y7Jz1Xp5Q8d2Z4W1 (USDT TRC20)"
