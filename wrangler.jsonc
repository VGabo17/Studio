{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synthetix-studio-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synthetix-db",
      "database_id": "e5bc9cba-e028-419b-9b81-96ff04597d0c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "synthetix-deliveries"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://synthetixstudio.dev"
  }
}
